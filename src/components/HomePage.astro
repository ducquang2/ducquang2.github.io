---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PlayerCard from "./PlayerCard.astro";
import PostChecklist from "./PostChecklist.astro";
import { t, links, projects, stack, localePath, formatDate, type Lang } from "../i18n";
import { getPosts } from "../lib/posts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const posts = (await getPosts(lang)).slice(0, 3);
const now = await getEntry("now", lang);
const { Content: NowContent } = now ? await render(now) : { Content: null };
---

<Base lang={lang} title="Duc Quang · ducquang2" path="/">
  <section class="hero wrap">
    <PlayerCard lang={lang} />
    <div class="hero-copy">
      <h1>ducquang2</h1>
      <p class="ticket">
        <span class="no">No. 002</span>
        <span>{s.series}</span>
        <span>{s.position}</span>
      </p>
      <p class="intro">{s.intro}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${links.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.6-8-5.6ZM5.6 7 12 11.5 18.4 7H5.6Z"
            ></path></svg
          >
          {s.actionEmail}
        </a>
        <a class="btn btn-secondary" href={links.github} rel="me noopener" target="_blank">
          <svg viewBox="0 0 16 16" aria-hidden="true"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
          GitHub
        </a>
        <a class="btn btn-secondary" href={links.linkedin} rel="me noopener" target="_blank">
          <svg viewBox="0 0 16 16" aria-hidden="true"
            ><path
              d="M0 1.15C0 .52.53 0 1.18 0h13.64C15.47 0 16 .52 16 1.15v13.7c0 .63-.53 1.15-1.18 1.15H1.18C.53 16 0 15.48 0 14.85V1.15zm4.94 12.24V6.17H2.54v7.22h2.4zM3.74 5.18c.84 0 1.36-.55 1.36-1.25-.02-.71-.52-1.25-1.34-1.25-.82 0-1.36.54-1.36 1.25 0 .7.52 1.25 1.33 1.25h.01zm4.91 8.21V9.36c0-.22.02-.43.08-.58.17-.43.57-.88 1.23-.88.87 0 1.22.66 1.22 1.64v3.86h2.4V9.25c0-2.22-1.18-3.25-2.76-3.25-1.27 0-1.84.7-2.16 1.19v.03h-.02l.02-.03V6.17h-2.4c.03.68 0 7.22 0 7.22h2.4z"
            ></path></svg
          >
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="about">
    <div class="section-head"><h2 id="about">{s.aboutTitle}</h2></div>
    <hr class="seam" />
    <div class="about">
      <div class="about-text">
        {s.about.map((p) => <p>{p}</p>)}
      </div>
      <dl class="stack">
        <div>
          <dt>{s.dailyDrivers}</dt>
          <dd class="stack-main">{stack.main.join(" · ")}</dd>
        </div>
        <div>
          <dt>{s.alsoUsed}</dt>
          <dd>{stack.also.join(" · ")}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="projects">
    <div class="section-head">
      <h2 id="projects">{s.projectsTitle}</h2>
      <a href={links.repos} target="_blank" rel="noopener">{s.allRepos}</a>
    </div>
    <hr class="seam" />
    <ol class="projects">
      {
        projects.map((p) => (
          <li>
            <h3>{p.name}</h3>
            <p class="p-desc">{p.desc[lang]}</p>
            <p class="p-stack">{p.stack}</p>
            <p class="p-links">
              {p.live && (
                <a href={p.live} target="_blank" rel="noopener">
                  {s.live}
                  <span class="visually-hidden">: {p.name}</span>
                </a>
              )}
              <a href={p.code} target="_blank" rel="noopener">
                {s.code}
                <span class="visually-hidden">: {p.name}</span>
              </a>
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="split wrap">
    <section class="section" aria-labelledby="writing">
      <div class="section-head">
        <h2 id="writing">{s.writingTitle}</h2>
        <a href={localePath(lang, "/blog/")}>{s.allPosts}</a>
      </div>
      <hr class="seam" />
      <PostChecklist lang={lang} posts={posts} />
    </section>

    {
      now && NowContent && (
        <section class="section" aria-labelledby="now">
          <div class="section-head">
            <h2 id="now">{s.nowTitle}</h2>
          </div>
          <hr class="seam" />
          <div class="now">
            <NowContent />
            <p class="ticket">
              <span>
                {s.updated} {formatDate(now.data.updated, lang)}
              </span>
              <a href={localePath(lang, "/now/")}>{s.nowMore}</a>
            </p>
          </div>
        </section>
      )
    }
  </div>

  <section class="contact" aria-labelledby="contact">
    <div class="wrap">
      <h2 id="contact">{s.contactTitle}</h2>
      <p>{s.contact}</p>
      <a class="contact-mail" href={`mailto:${links.email}`}>{links.email}</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
    min-height: min(calc(100svh - 90px), 920px);
    padding-block: clamp(32px, 5vw, 56px);
  }
  .hero-copy h1 {
    font-weight: 900;
    font-size: clamp(3.5rem, 8.4vw, 6rem);
    letter-spacing: -0.02em;
    line-height: 0.9;
  }
  .hero-copy .ticket {
    margin: 18px 0 0;
    font-size: 1.05rem;
  }
  .intro {
    margin: 22px 0 32px;
    max-width: 38ch;
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
    line-height: 1.6;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    padding-top: 32px;
  }
  .about-text p {
    margin: 0 0 1.1em;
    max-width: 62ch;
  }
  .about-text p:first-child {
    font-size: 1.25rem;
    line-height: 1.55;
  }
  .stack {
    margin: 0;
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .stack dt {
    font: 800 1.1rem/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--heading);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 10px;
  }
  .stack dd {
    margin: 0;
    color: var(--text-soft);
  }
  .stack .stack-main {
    font: 800 1.45rem/1.3 var(--font-display);
    color: var(--text);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .projects li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) auto;
    grid-template-areas: "name desc links" "name stack links";
    gap: 6px clamp(20px, 4vw, 48px);
    padding: 26px 0;
    border-bottom: 1px solid var(--rule);
  }
  .projects h3 {
    grid-area: name;
    font-weight: 900;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    text-transform: uppercase;
  }
  .p-desc {
    grid-area: desc;
    margin: 0;
    max-width: 60ch;
  }
  .p-stack {
    grid-area: stack;
    margin: 0;
    font: 700 0.95rem/1.3 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red-text);
  }
  .p-links {
    grid-area: links;
    margin: 0;
    display: flex;
    gap: 18px;
    font: 800 1.05rem/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
  }
  .now {
    padding-top: 22px;
  }
  .now :global(ul) {
    margin: 0 0 18px;
    padding-left: 1.1em;
  }
  .now :global(li) {
    margin-bottom: 10px;
  }
  .now :global(li::marker) {
    color: var(--rule-accent);
  }
  .now .ticket {
    margin: 0;
  }

  .contact {
    margin-top: clamp(72px, 10vw, 128px);
    background: var(--print-navy);
    color: var(--print-white);
    border-top: 6px solid var(--print-red);
    padding: clamp(56px, 8vw, 96px) 0;
  }
  .contact h2 {
    color: var(--print-white);
    font-weight: 800;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    text-transform: uppercase;
  }
  .contact p {
    margin: 16px 0 28px;
    max-width: 52ch;
    color: #d9dfea;
  }
  .contact-mail {
    font: 900 clamp(1.9rem, 6vw, 4.5rem)/1 var(--font-display);
    color: var(--print-white);
    text-decoration-color: #e0666b;
    text-decoration-thickness: 4px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }
  .contact-mail:focus-visible {
    outline-color: var(--print-white);
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 40px;
      justify-items: center;
    }
    .hero-copy {
      justify-self: stretch;
    }
    .about,
    .split {
      grid-template-columns: 1fr;
    }
    .projects li {
      grid-template-columns: 1fr;
      grid-template-areas: "name" "desc" "stack" "links";
      gap: 10px;
    }
  }
</style>
