---
import { t, cardNo, formatDate, localePath, type Lang } from "../i18n";
import type { Post } from "../lib/posts";

interface Props {
  lang: Lang;
  posts: Post[];
  /** Heading level for post titles inside the list. */
  level?: "h2" | "h3";
}
const { lang, posts, level = "h3" } = Astro.props;
const s = t[lang];
const Title = level;
---

{
  posts.length === 0 ? (
    <div class="sleeve">
      <p class="sleeve-title">{s.emptyTitle}</p>
      <p>{s.empty}</p>
    </div>
  ) : (
    <ol class="checklist">
      {posts.map((p) => (
        <li>
          <span class="no" aria-label={`${s.no} ${p.no}`}>{cardNo(p.no)}</span>
          <div class="body">
            <Title class="title">
              <a href={localePath(lang, `/blog/${p.slug}/`)}>{p.data.title}</a>
            </Title>
            <p class="desc">{p.data.description}</p>
          </div>
          <p class="meta">
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
            <span class="langs">{p.hasTranslation ? "EN · VI" : lang.toUpperCase()}</span>
          </p>
        </li>
      ))}
    </ol>
  )
}

<style>
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .checklist li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 6px 24px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
  }
  .no {
    font: 900 1.75rem/1 var(--font-display);
    color: var(--red-text);
    font-variant-numeric: tabular-nums;
  }
  .title {
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.05;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--rule-accent);
    text-decoration-thickness: 3px;
  }
  .desc {
    margin: 8px 0 0;
    color: var(--text-soft);
    max-width: 62ch;
  }
  .meta {
    margin: 0;
    display: grid;
    justify-items: end;
    gap: 4px;
    font: 700 0.95rem/1.2 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-soft);
    white-space: nowrap;
  }
  .langs {
    color: var(--link);
  }
  .sleeve {
    margin-top: 28px;
    border: 2px dashed var(--rule);
    border-radius: 10px;
    padding: clamp(28px, 5vw, 48px);
    color: var(--text-soft);
  }
  .sleeve p {
    margin: 0;
  }
  .sleeve-title {
    font: 800 clamp(1.5rem, 3vw, 2rem)/1.1 var(--font-display);
    color: var(--heading);
    text-transform: uppercase;
    margin-bottom: 8px !important;
  }
  @media (max-width: 640px) {
    .checklist li {
      grid-template-columns: 3.25rem minmax(0, 1fr);
    }
    .meta {
      grid-column: 2;
      justify-items: start;
      display: flex;
      gap: 14px;
    }
  }
</style>
